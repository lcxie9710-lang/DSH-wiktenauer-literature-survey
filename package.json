{
  "name": "dsh-hema-literature",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "DSH 上的 HEMA（欧洲历史武术）文献研究：Wiktenauer 数据层 + 以 JEV 为验证器的证据-断言链路。两个包：@ghogiel/dsh-hema-v2（研究链路，preset 层）与 @ghogiel/dsh-jev（JEV 评估模型工具）。",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "install:dsh": "node install.mjs",
    "test": "node packages/dsh-hema-v2/probes/run-all.mjs",
    "test:plugin": "node packages/dsh-hema-v2/probes/test-plugin.mjs",
    "test:chain": "node packages/dsh-hema-v2/probes/test-chain.mjs",
    "test:jev": "node packages/dsh-hema-v2/probes/test-jev.mjs",
    "test:report": "node packages/dsh-hema-v2/probes/test-report.mjs",
    "test:data": "node packages/dsh-hema-v2/probes/test-data-tools.mjs",
    "preset:sync": "node packages/dsh-hema-v2/preset/sync-preset.mjs",
    "preset:install": "node packages/dsh-hema-v2/preset/install.mjs",
    "preset:verify": "node packages/dsh-hema-v2/preset/verify-preset.mjs",
    "preset:mount": "node packages/dsh-hema-v2/preset/verify-mount.mjs",
    "profiles:verify": "node packages/dsh-hema-v2/harness/verify-profiles.mjs",
    "jev:verify": "node packages/dsh-jev/verify.mjs",
    "run": "node packages/dsh-hema-v2/harness/run.mjs"
  }
}
