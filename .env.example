# JEV 走 Vercel AI Gateway，需要一个 gateway key。
# 复制成 .env 并填入真值：cp .env.example .env
#
# .env 已在 .gitignore 里，不会被提交。
#
# 解析顺序（每次调用重新解析，轮换 key 后下一次请求就生效）：
#   1. preset 行里的 config.apiKey
#   2. process.env[config.apiKeyEnv]，默认就是下面这个名字
#   3. DSH 凭据库（dsh 设置界面里存的那个）
#   4. <DSH_HOME>/.env
#
# 自检（会真调一次网关）：node packages/dsh-jev/verify-key.mjs

AI_GATEWAY_API_KEY=vck_replace_me

# 可选：换网关根地址（默认 https://ai-gateway.vercel.sh/v4/ai，会拼上 /evaluation-model）
# AI_GATEWAY_BASE_URL=

# 可选：换环境变量名字（preset 行里配 apiKeyEnv 时才需要）
# JEV_API_KEY_ENV=AI_GATEWAY_API_KEY
